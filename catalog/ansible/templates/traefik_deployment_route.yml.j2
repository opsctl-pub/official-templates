{% set effective_route_hosts = route_hosts | default([], true) %}
{% if (effective_route_hosts | length) == 0 and route_host is defined and (route_host | string | length) > 0 %}
{%   set effective_route_hosts = [route_host] %}
{% endif %}
http:
  routers:
{% if redirect_http_to_https %}
    deployment-{{ deployment_id }}-http-redirect:
      rule: 'Host({% for host in effective_route_hosts %}`{{ host }}`{% if not loop.last %},{% endif %}{% endfor %})'
      priority: 1000
      entryPoints:
        - web
      middlewares:
        - deployment-{{ deployment_id }}-https-redirect
      service: noop@internal
{% endif %}
    deployment-{{ deployment_id }}:
      rule: 'Host({% for host in effective_route_hosts %}`{{ host }}`{% if not loop.last %},{% endif %}{% endfor %})'
      priority: 1000
      entryPoints:
{% if route_https | default(true) %}
        - websecure
{% if route_tls_cert_resolver is defined and (route_tls_cert_resolver | string | length) > 0 %}
      tls:
        certResolver: {{ route_tls_cert_resolver }}
{% else %}
      tls: {}
{% endif %}
{% else %}
        - web
{% endif %}
{% if route_middlewares | default([]) | length > 0 %}
      middlewares:
{% for middleware in route_middlewares %}
        - {{ middleware }}
{% endfor %}
{% endif %}
      service: deployment-{{ deployment_id }}
{% if redirect_http_to_https %}
  middlewares:
    deployment-{{ deployment_id }}-https-redirect:
      redirectScheme:
        scheme: https
        permanent: true
{% endif %}
  services:
    deployment-{{ deployment_id }}:
      loadBalancer:
        passHostHeader: true
        servers:
{% for backend in traefik_backends %}
          - url: {{ backend.url | to_json }}
{% endfor %}
