name: {{ ('opsctl-' ~ (app_local_runtime.deployment_id | replace('-', ''))) | to_json }}
services:
  app:
    image: {{ app_local_runtime.image | to_json }}
    container_name: {{ app_local_runtime.container_name | to_json }}
    restart: unless-stopped
    pull_policy: never
{% if app_local_runtime.command | default(none) is not none %}
    command: {{ app_local_runtime.command | map('replace', '$', '$$') | list | to_json }}
{% endif %}
{% if app_local_runtime.memory_bytes | default(none) is not none %}
    mem_limit: {{ app_local_runtime.memory_bytes }}
{% endif %}
    environment:
{% for key, value in app_local_runtime.env | default({}) | dictsort %}
      {{ key | to_json }}: {{ value | replace('$', '$$') | to_json }}
{% endfor %}
    labels:
      com.opsctl.managed: 'true'
      com.opsctl.org_id: {{ app_local_runtime.organization_id | to_json }}
      com.opsctl.deployment_id: {{ app_local_runtime.deployment_id | to_json }}
      com.opsctl.server_id: {{ app_local_runtime.server_id | to_json }}
      com.opsctl.revision_id: {{ app_local_runtime.revision_id | to_json }}
      com.opsctl.operation_id: {{ app_local_runtime.operation_id | to_json }}
      com.opsctl.app: {{ app_local_runtime.app_slug | to_json }}
{% if app_local_runtime.project_id | default(none) is not none %}
      com.opsctl.project_id: {{ app_local_runtime.project_id | to_json }}
{% endif %}
{% for key, value in app_local_runtime.labels | default({}) | dictsort %}
      {{ key | to_json }}: {{ value | replace('$', '$$') | to_json }}
{% endfor %}
{% if app_local_runtime.health_exec | default(none) is not none %}
    healthcheck:
      test: {{ (['CMD'] + app_local_runtime.health_exec) | map('replace', '$', '$$') | list | to_json }}
      interval: 5s
      timeout: 5s
      retries: 20
{% endif %}
{% if app_local_runtime.published_ports | default([]) | length %}
    ports:
{% for binding in app_local_runtime.published_ports %}
      - {{ (binding.host_ip ~ ':' ~ binding.host_port ~ ':' ~ binding.container_port ~ '/tcp') | to_json }}
{% endfor %}
{% else %}
    ports: []
{% endif %}
    volumes:
{% for mount in app_local_runtime.mounts %}
      - type: volume
        source: {{ ('vol-' ~ (mount.volume_id | replace('-', '')) ~ '-g' ~ mount.generation) | to_json }}
        target: {{ mount.path | to_json }}
        read_only: {{ (mount.mode == 'ro') | to_json }}
{% endfor %}
{% if not app_local_runtime.mounts %}
      []
{% endif %}
    networks:
{% for network in app_local_runtime.networks %}
      {{ ('net-' ~ (network.id | replace('-', '')) ~ '-g' ~ network.generation) | to_json }}:
        aliases: {{ network.aliases | default([]) | to_json }}
{% endfor %}
{% if not app_local_runtime.networks %}
      default: {}
{% endif %}
volumes:
{% for mount in app_local_runtime.mounts | unique(attribute='volume_id') %}
  {{ ('vol-' ~ (mount.volume_id | replace('-', '')) ~ '-g' ~ mount.generation) | to_json }}:
    external: true
    name: {{ ('opsctl-vol-' ~ (app_local_runtime.organization_id | replace('-', '')) ~ '-' ~ (mount.volume_id | replace('-', '')) ~ '-g' ~ mount.generation) | to_json }}
{% endfor %}
{% if not app_local_runtime.mounts %}
  {}
{% endif %}
networks:
{% for network in app_local_runtime.networks %}
  {{ ('net-' ~ (network.id | replace('-', '')) ~ '-g' ~ network.generation) | to_json }}:
    external: true
    name: {{ ('opsctl-net-' ~ (app_local_runtime.organization_id | replace('-', '')) ~ '-' ~ (network.id | replace('-', '')) ~ '-g' ~ network.generation) | to_json }}
{% endfor %}
{% if not app_local_runtime.networks %}
  default: {}
{% endif %}
