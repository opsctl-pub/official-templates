{
  "format_version": 2,
  "engine": "opentofu",
  "private_ingress": {
    "input": "opsctl_server.private_ingress_bindings",
    "source": "ipv4_host",
    "protocols": ["tcp"]
  },
  "ssh_bootstrap": {
    "input": "opsctl_server.ssh_port",
    "configuration": "first_boot",
    "profiles": [{"distribution": "ubuntu", "versions": ["22.04", "24.04"]}]
  }
}
